{
  "rules": {
    "servers": {
      "$serverId": {
        ".read": "auth != null && auth.token.email === 'admin@ana.studio'",
        ".write": false,
        "history": {
          ".indexOn": ["timestamp"]
        },
        "backup": {
          "requests": {
            ".write": "auth != null && auth.token.email === 'admin@ana.studio'",
            ".indexOn": ["status", "createdAt"]
          }
        }
      }
    }
  }
}
